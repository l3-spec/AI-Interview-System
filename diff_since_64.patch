+  border-radius: var(--radius-lg);
+  padding: 24px;
+  overflow: hidden;
+  transition: all var(--duration-normal) var(--ease-out-expo);
+}
+
+.chart-container:hover {
+  border-color: var(--glass-border-hover);
+}
+
+.chart-container__title {
+  font-size: 15px;
+  font-weight: 700;
+  color: var(--text-primary);
+  margin-bottom: 20px;
+  letter-spacing: -0.3px;
+}
+
+
+/* ═══════════════════════════════════════════════
+   Table 液态风格覆盖
+   ═══════════════════════════════════════════════ */
+
+.glass-table .ant-table {
+  background: transparent !important;
+  color: var(--text-secondary) !important;
+}
+
+.glass-table .ant-table-thead > tr > th {
+  background: rgba(255, 255, 255, 0.03) !important;
+  color: var(--text-tertiary) !important;
+  border-bottom: 1px solid var(--glass-border) !important;
+  font-size: 12px;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.5px;
+}
+
+.glass-table .ant-table-tbody > tr > td {
+  border-bottom: 1px solid rgba(255, 255, 255, 0.04) !important;
+  color: var(--text-secondary) !important;
+}
+
+.glass-table .ant-table-tbody > tr:hover > td {
+  background: rgba(56, 189, 248, 0.05) !important;
+}
+
+.glass-table .ant-pagination-item-active {
+  background: linear-gradient(135deg, var(--glass-primary), var(--glass-secondary)) !important;
+  border-color: transparent !important;
+}
+
+
+/* ═══════════════════════════════════════════════
+   表单输入
+   ═══════════════════════════════════════════════ */
+
+.glass-input {
+  background: rgba(255, 255, 255, 0.04) !important;
+  border: 1px solid var(--glass-border) !important;
+  border-radius: var(--radius-md) !important;
+  color: var(--text-primary) !important;
+  transition: all var(--duration-fast) var(--ease-out-expo) !important;
+}
+
+.glass-input:hover {
+  border-color: var(--glass-border-hover) !important;
+  background: rgba(255, 255, 255, 0.06) !important;
+}
+
+.glass-input:focus,
+.glass-input-focused {
+  border-color: var(--glass-primary) !important;
+  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15) !important;
+}
+
+
+/* ═══════════════════════════════════════════════
+   Modal / Drawer
+   ═══════════════════════════════════════════════ */
+
+.glass-modal .ant-modal-content {
+  background: rgba(15, 23, 41, 0.85) !important;
+  backdrop-filter: blur(30px) saturate(2) !important;
+  -webkit-backdrop-filter: blur(30px) saturate(2) !important;
+  border: 1px solid var(--glass-border) !important;
+  border-radius: var(--radius-lg) !important;
+  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5) !important;
+}
+
+.glass-modal .ant-modal-header {
+  background: transparent !important;
+  border-bottom: 1px solid var(--glass-border) !important;
+}
+
+.glass-modal .ant-modal-title {
+  color: var(--text-primary) !important;
+}
+
+
+/* ═══════════════════════════════════════════════
+   Tag / Badge
+   ═══════════════════════════════════════════════ */
+
+.glass-tag {
+  background: rgba(56, 189, 248, 0.1) !important;
+  border: 1px solid rgba(56, 189, 248, 0.2) !important;
+  color: var(--glass-primary) !important;
+  border-radius: 6px !important;
+  font-weight: 600;
+}
+
+.glass-tag--purple {
+  background: rgba(167, 139, 250, 0.1) !important;
+  border-color: rgba(167, 139, 250, 0.2) !important;
+  color: var(--glass-secondary) !important;
+}
+
+.glass-tag--pink {
+  background: rgba(244, 114, 182, 0.1) !important;
+  border-color: rgba(244, 114, 182, 0.2) !important;
+  color: var(--glass-accent) !important;
+}
+
+.glass-tag--teal {
+  background: rgba(45, 212, 191, 0.1) !important;
+  border-color: rgba(45, 212, 191, 0.2) !important;
+  color: var(--glass-teal) !important;
+}
+
+
+/* ═══════════════════════════════════════════════
+   Page transition
+   ═══════════════════════════════════════════════ */
+
+.page-enter {
+  animation: page-in 0.5s var(--ease-spring);
+}
+
+@keyframes page-in {
+  from {
+    opacity: 0;
+    transform: translateY(12px) scale(0.99);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0) scale(1);
+  }
+}
+
+
+/* ═══════════════════════════════════════════════
+   Scrollbar
+   ═══════════════════════════════════════════════ */
+
+::-webkit-scrollbar {
+  width: 6px;
+  height: 6px;
+}
+
+::-webkit-scrollbar-track {
+  background: rgba(255, 255, 255, 0.02);
+  border-radius: 3px;
+}
+
+::-webkit-scrollbar-thumb {
+  background: rgba(255, 255, 255, 0.1);
+  border-radius: 3px;
+}
+
+::-webkit-scrollbar-thumb:hover {
+  background: rgba(255, 255, 255, 0.2);
+}
