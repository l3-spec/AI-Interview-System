+++ b/admin-dashboard/src/styles/liquid-glass.css
@@ -0,0 +1,774 @@
+/* ═══════════════════════════════════════════════
+   Liquid Glass Design System v2.0
+   液态玻璃风格 + 动态光效
+   ═══════════════════════════════════════════════ */
+
+:root {
+  /* ── 基础色调 ── */
+  --bg-deep: #020617;
+  --bg-elevated: #0a0f1f;
+  --bg-surface: #0f172a;
+
+  /* ── 液态玻璃主色 ── */
+  --glass-primary: #38bdf8;       /* 天蓝 */
+  --glass-secondary: #818cf8;     /* 靛蓝 */
+  --glass-accent: #f472b6;        /* 粉 */
+  --glass-teal: #2dd4bf;          /* 青 */
+  --glass-gold: #fbbf24;          /* 暖金 */
+  --accent: #38bdf8;
+
+  /* ── 光效色 ── */
+  --glow-primary: rgba(56, 189, 248, 0.4);
+  --glow-secondary: rgba(129, 140, 248, 0.3);
+  --glow-accent: rgba(244, 114, 182, 0.25);
+  --glow-teal: rgba(45, 212, 191, 0.35);
+
+  /* ── 液态玻璃材质 ── */
+  --glass-bg: rgba(255, 255, 255, 0.02);
+  --glass-bg-hover: rgba(255, 255, 255, 0.05);
+  --glass-bg-active: rgba(255, 255, 255, 0.08);
+  --glass-border: rgba(255, 255, 255, 0.08);
+  --glass-border-hover: rgba(255, 255, 255, 0.15);
+  --glass-border-active: rgba(56, 189, 248, 0.35);
+  --glass-blur: 24px;
+  --glass-blur-heavy: 40px;
+  --glass-saturate: 2;
+
+  /* ── 文字 ── */
+  --text-main: #f8fafc;
+  --text-primary: #f1f5f9;
+  --text-secondary: #94a3b8;
+  --text-tertiary: #64748b;
+  --text-muted: #475569;
+  --text-accent: #38bdf8;
+
+  /* ── 系统变量 (动态) ── */
+  --mouse-x: 50%;
+  --mouse-y: 50%;
+
+  /* ── 圆角系统 ── */
+  --radius-sm: 12px;
+  --radius-md: 18px;
+  --radius-lg: 28px;
+  --radius-xl: 40px;
+
+  /* ── 阴影 ── */
+  --shadow-glass: 0 10px 40px rgba(0, 0, 0, 0.5);
+  --shadow-glow-sm: 0 0 20px var(--glow-primary);
+  --shadow-glow-md: 0 0 50px var(--glow-primary);
+
+  /* ── 过渡 ── */
+  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
+  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
+  --duration-fast: 200ms;
+  --duration-normal: 400ms;
+  --duration-slow: 800ms;
+}
+
+/* ═══════════════════════════════════════════════
+   全局基底
+   ═══════════════════════════════════════════════ */
+
+body {
+  background: var(--bg-deep);
+  color: var(--text-primary);
+}
+
+/* 动态网格背景 + 深度效果 */
+body::after {
+  content: "";
+  position: fixed;
+  inset: 0;
+  background-image:
+    linear-gradient(rgba(56, 189, 248, 0.05) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(56, 189, 248, 0.05) 1px, transparent 1px);
+  background-size: 80px 80px;
+  mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), black 20%, transparent 80%);
+  -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), black 20%, transparent 80%);
+  pointer-events: none;
+  z-index: -2;
+  animation: grid-drift 60s linear infinite;
+  opacity: 0.4;
+}
+
+@keyframes grid-drift {
+  0% { background-position: 0 0; }
+  100% { background-position: 80px 80px; }
+}
+
+/* ═══════════════════════════════════════════════
+   动态光斑
+   ═══════════════════════════════════════════════ */
+
+.aurora-blobs {
+  position: fixed;
+  inset: 0;
+  overflow: hidden;
+  pointer-events: none;
+  z-index: -1;
+}
+
+.aurora-blob {
+  position: absolute;
+  border-radius: 50%;
+  filter: blur(120px);
+  opacity: 0.5;
+  animation-timing-function: ease-in-out;
+  animation-iteration-count: infinite;
+}
+
+.aurora-blob--1 {
+  width: 600px;
+  height: 600px;
+  background: radial-gradient(circle, var(--glow-primary), transparent 70%);
+  top: -10%;
+  right: -10%;
+  animation: blob-float-1 20s infinite alternate;
+}
+
+.aurora-blob--2 {
+  width: 500px;
+  height: 500px;
+  background: radial-gradient(circle, var(--glow-secondary), transparent 70%);
+  bottom: -10%;
+  left: -5%;
+  animation: blob-float-2 25s infinite alternate;
+}
+
+.aurora-blob--3 {
+  width: 400px;
+  height: 400px;
+  background: radial-gradient(circle, var(--glow-accent), transparent 70%);
+  top: 40%;
+  left: 30%;
+  animation: blob-float-3 18s infinite alternate;
+}
+
+.aurora-blob--4 {
+  width: 350px;
+  height: 350px;
+  background: radial-gradient(circle, var(--glow-teal), transparent 70%);
+  top: 20%;
+  left: 55%;
+  animation: blob-float-4 22s infinite alternate;
+}
+
+@keyframes blob-float-1 {
+  0% { transform: translate(0, 0) scale(1); }
+  33% { transform: translate(-8%, 12%) scale(1.15); }
+  66% { transform: translate(5%, -5%) scale(0.9); }
+  100% { transform: translate(3%, 8%) scale(1.05); }
+}
+
+@keyframes blob-float-2 {
+  0% { transform: translate(0, 0) scale(1); }
+  33% { transform: translate(10%, -8%) scale(1.1); }
+  66% { transform: translate(-6%, 12%) scale(0.85); }
+  100% { transform: translate(-4%, -2%) scale(1.08); }
+}
+
+@keyframes blob-float-3 {
+  0% { transform: translate(0, 0) scale(1); }
+  50% { transform: translate(15%, -10%) scale(1.2); }
+  100% { transform: translate(-8%, 15%) scale(0.95); }
+}
+
+@keyframes blob-float-4 {
+  0% { transform: translate(0, 0) scale(1); }
+  50% { transform: translate(-12%, -15%) scale(1.1); }
+  100% { transform: translate(10%, 5%) scale(0.9); }
+}
+
+/* ═══════════════════════════════════════════════
+   浮动光粒子
+   ═══════════════════════════════════════════════ */
+
+.particles-container {
+  position: fixed;
+  inset: 0;
+  pointer-events: none;
+  z-index: 0;
+  overflow: hidden;
+}
+
+.light-particle {
+  position: absolute;
+  width: 2px;
+  height: 2px;
+  background: var(--glass-primary);
+  border-radius: 50%;
+  box-shadow: 0 0 6px 2px var(--glow-primary);
+  animation: particle-rise linear infinite;
+  opacity: 0;
+}
+
+@keyframes particle-rise {
+  0% {
+    transform: translateY(100vh) scale(0);
+    opacity: 0;
+  }
+  10% {
+    opacity: 1;
+  }
+  90% {
+    opacity: 1;
+  }
+  100% {
+    transform: translateY(-10vh) scale(1.5);
+    opacity: 0;
+  }
+}
+
+
+/* ═══════════════════════════════════════════════
+   液态玻璃卡片 ── 核心组件
+   ═══════════════════════════════════════════════ */
+
+.liquid-card {
+  position: relative;
+  background: var(--glass-bg);
+  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+  border: 1px solid var(--glass-border);
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow-glass);
+  overflow: hidden;
+  transition:
+    all var(--duration-normal) var(--ease-out-expo);
+}
+
+.liquid-card::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(
+    135deg,
+    rgba(255, 255, 255, 0.06) 0%,
+    transparent 40%,
+    rgba(255, 255, 255, 0.02) 100%
+  );
+  pointer-events: none;
+  z-index: 0;
+  transition: opacity var(--duration-normal) var(--ease-out-expo);
+}
+
+/* 顶部光条 */
+.liquid-card::after {
+  content: "";
+  position: absolute;
+  top: 0;
+  left: 50%;
+  transform: translateX(-50%);
+  width: 60%;
+  height: 1px;
+  background: linear-gradient(
+    90deg,
+    transparent,
+    rgba(255, 255, 255, 0.15),
+    transparent
+  );
+  pointer-events: none;
+  z-index: 1;
+  opacity: 0.6;
+}
+
+.liquid-card:hover {
+  background: var(--glass-bg-hover);
+  border-color: var(--glass-border-hover);
+  box-shadow:
+    var(--shadow-glass),
+    0 0 30px rgba(56, 189, 248, 0.1);
+  transform: translateY(-2px);
+}
+
+.liquid-card:hover::before {
+  opacity: 1.5;
+}
+
+.liquid-card > * {
+  position: relative;
+  z-index: 1;
+}
+
+
+/* ═══════════════════════════════════════════════
+   动态渐变边框卡片
+   ═══════════════════════════════════════════════ */
+
+.gradient-border-card {
+  position: relative;
+  background: var(--glass-bg);
+  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+  border-radius: var(--radius-lg);
+  overflow: visible;
+  transition: all var(--duration-normal) var(--ease-out-expo);
+}
+
+.gradient-border-card::before {
+  content: "";
+  position: absolute;
+  inset: -1px;
+  border-radius: calc(var(--radius-lg) + 1px);
+  background: conic-gradient(
+    from var(--border-angle, 0deg),
+    var(--glass-primary),
+    var(--glass-secondary),
+    var(--glass-accent),
+    var(--glass-primary)
+  );
+  -webkit-mask:
+    linear-gradient(#fff 0 0) content-box,
+    linear-gradient(#fff 0 0);
+  -webkit-mask-composite: xor;
+  mask-composite: exclude;
+  z-index: -1;
+  opacity: 0.4;
+  transition: opacity var(--duration-normal) var(--ease-out-expo);
+  animation: border-rotate 4s linear infinite;
+}
+
+.gradient-border-card:hover::before {
+  opacity: 1;
+}
+
+@property --border-angle {
+  syntax: '<angle>';
+  initial-value: 0deg;
+  inherits: false;
+}
+
+@keyframes border-rotate {
+  to { --border-angle: 360deg; }
+}
+
+
+/* ═══════════════════════════════════════════════
+   光效按钮
+   ═══════════════════════════════════════════════ */
+
+.glass-btn {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  padding: 12px 28px;
+  border: 1px solid var(--glass-border);
+  border-radius: var(--radius-md);
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--text-primary);
+  background: var(--glass-bg);
+  backdrop-filter: blur(12px) saturate(var(--glass-saturate));
+  -webkit-backdrop-filter: blur(12px) saturate(var(--glass-saturate));
+  cursor: pointer;
+  overflow: hidden;
+  transition: all var(--duration-fast) var(--ease-out-expo);
+  user-select: none;
+}
+
+.glass-btn--primary {
+  background: linear-gradient(135deg, var(--glass-primary) 0%, var(--glass-secondary) 100%);
+  border-color: transparent;
+  box-shadow: 0 4px 20px var(--glow-primary);
+  color: white;
+}
+
+.glass-btn:hover {
+  transform: translateY(-2px);
+  border-color: var(--glass-border-hover);
+  box-shadow: 0 8px 30px var(--glow-primary);
+}
+
+.glass-btn:active {
+  transform: translateY(0) scale(0.98);
+}
+
+.glass-btn__shimmer {
+  position: absolute;
+  top: 0;
+  left: -100%;
+  width: 60%;
+  height: 100%;
+  background: linear-gradient(
+    90deg,
+    transparent,
+    rgba(255, 255, 255, 0.15),
+    transparent
+  );
+  transform: skewX(-20deg);
+  transition: left 0.6s ease;
+}
+
+.glass-btn:hover .glass-btn__shimmer {
+  left: 150%;
+}
+
+.glass-btn__ripple {
+  position: absolute;
+  border-radius: 50%;
+  background: rgba(255, 255, 255, 0.3);
+  transform: scale(0);
+  animation: ripple 0.6s ease-out;
+  pointer-events: none;
+}
+
+@keyframes ripple {
+  to {
+    transform: scale(4);
+    opacity: 0;
+  }
+}
+
+
+/* ═══════════════════════════════════════════════
+   计数器 / 统计卡片
+   ═══════════════════════════════════════════════ */
+
+.stat-card {
+  position: relative;
+  background: var(--glass-bg);
+  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+  border: 1px solid var(--glass-border);
+  border-radius: var(--radius-lg);
+  padding: 24px;
+  display: flex;
+  align-items: center;
+  gap: 20px;
+  overflow: hidden;
+  transition: all var(--duration-normal) var(--ease-out-expo);
+}
+
+.stat-card:hover {
+  border-color: var(--glass-border-active);
+  box-shadow: 0 0 30px rgba(56, 189, 248, 0.15);
+  transform: translateY(-3px);
+}
+
+.stat-card__icon {
+  width: 52px;
+  height: 52px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: var(--radius-md);
+  font-size: 24px;
+  background: rgba(56, 189, 248, 0.1);
+  border: 1px solid rgba(56, 189, 248, 0.2);
+  flex-shrink: 0;
+}
+
+.stat-card__icon--purple {
+  background: rgba(167, 139, 250, 0.1);
+  border-color: rgba(167, 139, 250, 0.2);
+  color: var(--glass-secondary);
+}
+
+.stat-card__icon--pink {
+  background: rgba(244, 114, 182, 0.1);
+  border-color: rgba(244, 114, 182, 0.2);
+  color: var(--glass-accent);
+}
+
+.stat-card__icon--teal {
+  background: rgba(45, 212, 191, 0.1);
+  border-color: rgba(45, 212, 191, 0.2);
+  color: var(--glass-teal);
+}
+
+.stat-card__label {
+  font-size: 12px;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 1.5px;
+  color: var(--text-tertiary);
+  margin-bottom: 4px;
+}
+
+.stat-card__value {
+  font-size: 32px;
+  font-weight: 800;
+  line-height: 1;
+  background: linear-gradient(135deg, var(--text-primary) 0%, var(--text-secondary) 100%);
+  -webkit-background-clip: text;
+  -webkit-text-fill-color: transparent;
+  background-clip: text;
+}
+
+.stat-card__trend {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 12px;
+  font-weight: 600;
+  margin-top: 6px;
+}
+
+.stat-card__trend--up { color: var(--glass-teal); }
+.stat-card__trend--down { color: var(--glass-accent); }
+
+/* 角落光晕 */
+.stat-card::after {
+  content: "";
+  position: absolute;
+  top: -30%;
+  right: -20%;
+  width: 150px;
+  height: 150px;
+  border-radius: 50%;
+  filter: blur(40px);
+  opacity: 0.15;
+  pointer-events: none;
+  transition: opacity var(--duration-normal) var(--ease-out-expo);
+}
+
+.stat-card:hover::after {
+  opacity: 0.3;
+}
+
+
+/* ═══════════════════════════════════════════════
+   侧边栏 ── 液态玻璃
+   ═══════════════════════════════════════════════ */
+
+.glass-sidebar {
+  background: rgba(15, 23, 41, 0.7) !important;
+  backdrop-filter: blur(30px) saturate(2) !important;
+  -webkit-backdrop-filter: blur(30px) saturate(2) !important;
+  border-right: 1px solid var(--glass-border) !important;
+}
+
+.glass-sidebar .ant-menu {
+  background: transparent !important;
+  border-inline-end: none !important;
+}
+
+.glass-sidebar .ant-menu-item,
+.glass-sidebar .ant-menu-submenu-title {
+  margin: 4px 12px !important;
+  border-radius: var(--radius-md) !important;
+  transition: all var(--duration-fast) var(--ease-out-expo) !important;
+  color: var(--text-secondary) !important;
+}
+
+.glass-sidebar .ant-menu-item:hover,
+.glass-sidebar .ant-menu-submenu-title:hover {
+  background: rgba(56, 189, 248, 0.08) !important;
+  color: var(--text-primary) !important;
+}
+
+.glass-sidebar .ant-menu-item-selected {
+  background: linear-gradient(
+    135deg,
+    rgba(56, 189, 248, 0.15) 0%,
+    rgba(167, 139, 250, 0.1) 100%
+  ) !important;
+  border: 1px solid rgba(56, 189, 248, 0.25) !important;
+  color: var(--text-primary) !important;
+}
+
+.glass-sidebar .ant-menu-sub {
+  background: rgba(0, 0, 0, 0.15) !important;
+  border-radius: var(--radius-md) !important;
+  margin: 4px 12px !important;
+}
+
+
+/* ═══════════════════════════════════════════════
+   顶部导航栏
+   ═══════════════════════════════════════════════ */
+
+.glass-header {
+  background: rgba(15, 23, 41, 0.6) !important;
+  backdrop-filter: blur(24px) saturate(2) !important;
+  -webkit-backdrop-filter: blur(24px) saturate(2) !important;
+  border-bottom: 1px solid var(--glass-border) !important;
+  box-shadow: 0 2px 20px rgba(0, 0, 0, 0.2) !important;
+}
+
+
+/* ═══════════════════════════════════════════════
+   图表容器
+   ═══════════════════════════════════════════════ */
+
+.chart-container {
+  position: relative;
+  background: var(--glass-bg);
+  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
